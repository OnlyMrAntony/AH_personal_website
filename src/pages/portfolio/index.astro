---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/Layout.astro';

// Fetch all markdown files inside src/content/portfolio/
const projects = await getCollection('portfolio');
---

<BaseLayout pageTitle="Portfolio | My Work">
  <h1>My Projects</h1>
  <p>Click on any project to view technical details, features, and write-ups.</p>

  <div style="display: grid; gap: 1.5rem; margin-top: 2rem;">
    {projects.map((project) => (
      <article style="padding: 1.5rem; border: 1px solid #e2e8f0; border-radius: 8px; background: #fff;">
        <h2 style="margin-top: 0;">{project.data.title}</h2>
        <p style="color: #4a5568;">{project.data.description}</p>
        
        <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
          {project.data.tags?.map((tag) => (
            <span style="background: #edf2f7; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.85rem; color: #2d3748;">
              {tag}
            </span>
          ))}
        </div>

        {/* Note: project.id matches the filename without the .md extension */}
        <a href={`/portfolio/${project.id}`} style="color: #3182ce; font-weight: 600; text-decoration: none;">
          Read Full Details &rarr;
        </a>
      </article>
    ))}
  </div>
</BaseLayout>